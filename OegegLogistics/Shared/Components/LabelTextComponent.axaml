<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OegegLogistics.Shared.Components">
    <Design.PreviewWith>
        <controls:LabelTextComponent />
    </Design.PreviewWith>

    <Style Selector="controls|LabelTextComponent">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Vertical">
                    <Label Content="{TemplateBinding LabelText}"
                           Target="{Binding #TextBlock}"/>
                    <TextBox Name="TextBlock"
                             Text="{TemplateBinding TextBoxText, Mode=TwoWay}"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
