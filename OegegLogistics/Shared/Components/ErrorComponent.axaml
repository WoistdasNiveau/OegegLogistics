<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OegegLogistics.Shared.Components">
    <Design.PreviewWith>
        <controls:ErrorComponent />
    </Design.PreviewWith>

    <Style Selector="controls|ErrorComponent">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*, auto">
                    <TextBlock Text="{TemplateBinding ErrorText}" />
                    <Button Grid.Row="1"
                            Content="{TemplateBinding ContinueButtonText}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
