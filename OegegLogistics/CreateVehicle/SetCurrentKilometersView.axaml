<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:createVehicle="clr-namespace:OegegLogistics.CreateVehicle"
             xmlns:models="clr-namespace:OegegLogistics.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OegegLogistics.CreateVehicle.SetCurrentKilometersView"
             x:DataType="createVehicle:SetCurrentKilometersViewModel">
    <Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Label Content="Momentaner Kilometerstand"
                   Target="currentKm"/>
            <TextBox Name="currentKm"
                     Text="{Binding CurrentKilometers}"/>
            <Label Content="Kilometerstand muss eine positive Zahl sein!"
                   IsVisible="{Binding IsCurrentKilometersNotValid }"/>
        </StackPanel>
    </Grid>
</UserControl>
