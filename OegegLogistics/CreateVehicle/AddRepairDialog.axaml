<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:OegegLogistics.Shared.Components"
             xmlns:models="clr-namespace:OegegLogistics.Models"
             xmlns:converters="clr-namespace:OegegLogistics.Shared.Converters"
             xmlns:createVehicle="clr-namespace:OegegLogistics.CreateVehicle"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OegegLogistics.CreateVehicle.AddRepairDialog"
             x:DataType="models:RepairModel">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ToleranceTypeToStringConverter x:Key="ToleranceTypeToStringConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border x:Name="Border">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Text="Ausbesserung hinzufügen"
                       Classes="Title"
                       HorizontalAlignment="Left"/>
            <Grid RowDefinitions="auto, 20, auto"
                  Grid.Row="1"
                  ColumnDefinitions="*,10,*"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
            <components:LabelTextComponent Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           LabelText="Bezeichnung"
                                           TextBoxText="{Binding Type}"/>
            
            <components:LabelTextComponent Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           LabelText="Beschreibung"
                                           TextBoxText="{Binding Description}"/>
            
            <components:LabelTextComponent Grid.Row="0"
                                           Grid.Column="2"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           LabelText="Kilometerlimit"
                                           TextBoxText="{Binding KilometerLimit}"/>
            
            <StackPanel Grid.Row="2"
                        Grid.Column="2"
                        Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto, *"
                      ColumnDefinitions="*, Auto">
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Toleranz"
                           HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             HorizontalAlignment="Stretch"
                             Text="{Binding Tolerance}"/>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Name="toleranceTypeBox"
                              SelectedItem="{Binding ToleranceType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToleranceTypeToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                </StackPanel>
        </Grid>
        </Grid>
    </Border>
    <!--
    <Grid RowDefinitions="*, *"
          ColumnDefinitions="*"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
