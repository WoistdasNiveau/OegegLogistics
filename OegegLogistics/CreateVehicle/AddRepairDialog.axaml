                    Spacing="10">
            <components:LabelTextComponent LabelText="Bezeichnung"
                                           TextBoxText="{Binding Type}"
                                           HorizontalAlignment="Stretch"/>
            <components:LabelTextComponent LabelText="Beschreibung"
                                           TextBoxText="{Binding Description}"
                                           HorizontalAlignment="Stretch"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Row="1"
                    Spacing="10">
            <components:LabelTextComponent LabelText="Kilometerlimit"
                                           TextBoxText="{Binding KilometerLimit}"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="5">
                <components:LabelTextComponent LabelText="Toleranz"
                                               TextBoxText="{Binding Tolerance}"/>
                <ComboBox Name="toleranceTypeBox"
                          SelectedItem="{Binding ToleranceType}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ToleranceTypeToStringConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel> 
        
    </Grid>-->
</UserControl>
